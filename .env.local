# PostgreSQL connection string (pooled URL for runtime; direct URL for migrations if your provider requires it)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# S3-compatible private storage (AWS S3, Cloudflare R2, etc.)
S3_REGION="auto"
S3_ENDPOINT="https://YOUR_S3_COMPATIBLE_ENDPOINT"
S3_BUCKET="margin-private-books"
S3_ACCESS_KEY_ID="YOUR_SERVER_SIDE_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="YOUR_SERVER_SIDE_SECRET"
S3_FORCE_PATH_STYLE="true"

# Public application URL, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
